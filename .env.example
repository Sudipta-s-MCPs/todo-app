# External Services (if needed)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Docker Profiles
# For local development with Redis: COMPOSE_PROFILES=local
# For production on Synology: COMPOSE_PROFILES=
COMPOSE_PROFILES=local