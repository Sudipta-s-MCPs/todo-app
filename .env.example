# ============================================
# SMART-TODO ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and update with your values
# 
# NOTE: Most application settings are now managed through the Admin Panel
# at http://your-server:5483/settings after initial setup
#
# Only core infrastructure settings remain in this file
# ============================================

# Environment
ENVIRONMENT=development

# Application Metadata - Infrastructure
PROJECT_NAME=Smart-ToDo
VERSION=1.0.0
DESCRIPTION=Advanced ToDo Application with MCP Support

# Database - Core infrastructure (must remain in env)
# PostgreSQL connection string for your external database
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Redis - Core infrastructure (must remain in env)
# Redis connection string for your external Redis instance
REDIS_URL=redis://your_redis_host:6379/0

# Security - Critical secrets (must remain in env)
# Generate a secure secret key for JWT tokens (use: openssl rand -hex 32)
SECRET_KEY=your-secure-secret-key-change-this-in-production
ALGORITHM=HS256

# API Configuration - Infrastructure (must remain in env)
API_V1_PREFIX=/api/v1
API_BASE_URL=http://localhost:5482
CORS_ORIGINS=["http://localhost:5483", "http://localhost:5484", "http://localhost:5482"]

# Port Configuration - Infrastructure (must remain in env)
BACKEND_PORT=5482
ADMIN_PORT=5483
FRONTEND_PORT=5484
MCP_PORT=5485

# MCP Configuration - Infrastructure
MCP_SERVER_NAME=TodoApp
MCP_SERVER_VERSION=1.0.0

# MFA Configuration - Infrastructure
MFA_ISSUER_NAME=Smart-ToDo

# Admin Configuration - Initial setup only
# Comma-separated list of admin usernames or emails
ADMIN_USERS=admin@example.com

# OAuth Configuration - Optional (must remain in env for security)
# OAUTH_ENABLED=false
# OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAUTH_GITHUB_CLIENT_ID=your-github-client-id
# OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend URL - Used for email links
FRONTEND_URL=http://localhost:5484

# Test Configuration
# API key for production testing (optional)
TEST_API_KEY=test_key_for_production_testing

# Monitoring - Infrastructure
LOG_LEVEL=INFO
# SENTRY_DSN=your-sentry-dsn-for-error-tracking

# ============================================
# SETTINGS MOVED TO ADMIN PANEL:
# ============================================
# The following settings are now managed through the Admin Panel
# at /settings after initial deployment:
#
# SECURITY SETTINGS:
# - Rate limiting (per minute/hour, burst)
# - Request validation, Security headers, Audit logging
# - Admin IP whitelist
# - Token expiration times (access, refresh, MCP)
#
# FEATURE FLAGS:
# - OAuth authentication
# - Multi-factor authentication (MFA)
# - API keys
# - WebSockets
#
# USER LIMITS:
# - Max workspaces per user
# - Max lists per workspace
# - Max tasks per list
# - Max API keys per user
# - Max devices per user
#
# LDAP CONFIGURATION:
# - LDAP enabled/disabled
# - Server hostname and port
# - SSL/TLS settings
# - Bind DN and password
# - Base DN and search configuration
# - User DN template
# - Attribute mappings (email, name, uid)
# - Group search settings
# - Auto-create user option
#
# AI INTEGRATION:
# - Groq API key and model selection
# - HuggingFace API token and model
# - Gemini API key and model
# - AI provider mode and priority
# - Temperature and max tokens
# - Cache TTL
# - Daily and monthly token limits
# - AI duplicate detection
# - Vector search enabled
#
# STORAGE INTEGRATIONS:
# - MinIO endpoint, access key, secret key
# - MinIO bucket name and HTTPS setting
# - Qdrant host, port, and API key
# - Qdrant collection name and embedding model
#
# EMAIL/SMTP SETTINGS:
# - SMTP server configuration
# - Email from address and name
# - Authentication credentials
#
# EXTERNAL SERVICES:
# - OAuth providers (Google, GitHub) - remain in .env for security
# - Sentry DSN for monitoring - remains in .env
# - Frontend URL for email links
#
# To initialize these settings after deployment:
# docker-compose exec backend python scripts/init_settings.py
# ============================================