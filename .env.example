# Environment
ENVIRONMENT=development

# Database - Synology NAS Configuration
DATABASE_URL=postgresql+asyncpg://sd_todo_app_user:AAqLX5r0lzm53hgQu48XIClw@192.168.11.100:15432/sd_todo_app_db
REDIS_URL=redis://192.168.11.100:6379/0

# Security - IMPORTANT: Change these in production!
SECRET_KEY=your-very-long-random-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MCP_TOKEN_EXPIRE_HOURS=24

# Security Features
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=600
RATE_LIMIT_BURST=10
ENABLE_REQUEST_VALIDATION=true
ENABLE_SECURITY_HEADERS=true
ENABLE_AUDIT_LOGGING=true

# IP Whitelist for admin endpoints (comma-separated, optional)
# ADMIN_IP_WHITELIST=192.168.11.100,192.168.11.101

# Feature Flags
OAUTH_ENABLED=false
MFA_ENABLED=true
API_KEYS_ENABLED=true
WEBSOCKETS_ENABLED=true

# User Limits
MAX_WORKSPACES_PER_USER=10
MAX_LISTS_PER_WORKSPACE=50
MAX_TASKS_PER_LIST=1000
MAX_API_KEYS_PER_USER=5
MAX_DEVICES_PER_USER=10

# LDAP Configuration (Synology Directory Server)
LDAP_ENABLED=false
LDAP_SERVER=sudipta.synology.me
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_BIND_DN=uid=root,cn=users,dc=sudipta,dc=synology,dc=me
LDAP_BIND_PASSWORD=your-ldap-bind-password
LDAP_BASE_DN=dc=sudipta,dc=synology,dc=me
LDAP_USER_DN_TEMPLATE=uid={username},cn=users,dc=sudipta,dc=synology,dc=me
LDAP_USER_SEARCH_BASE=cn=users,dc=sudipta,dc=synology,dc=me
LDAP_USER_FILTER=(objectClass=inetOrgPerson)
LDAP_USER_ATTR_EMAIL=mail
LDAP_USER_ATTR_NAME=displayName
LDAP_USER_ATTR_UID=uid
LDAP_GROUP_SEARCH_BASE=cn=groups,dc=sudipta,dc=synology,dc=me
LDAP_GROUP_FILTER=(objectClass=groupOfNames)
LDAP_CONNECTION_TIMEOUT=5
LDAP_AUTO_CREATE_USER=true

# API Configuration
API_V1_PREFIX=/api/v1
API_BASE_URL=http://localhost:5482
CORS_ORIGINS=["http://localhost:5483", "http://localhost:5484", "http://localhost:5482", "http://192.168.11.100:5483", "http://192.168.11.100:5484", "http://192.168.11.100:5482", "https://192.168.11.100:5483", "https://192.168.11.100:5484", "https://192.168.11.100:5482"]

# Port Configuration
BACKEND_PORT=5482
ADMIN_PORT=5483
FRONTEND_PORT=5484
MCP_PORT=5485

# MCP Configuration
MCP_SERVER_NAME=TodoApp
MCP_SERVER_VERSION=1.0.0

# AI Integration (Groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500
AI_CACHE_TTL=86400
AI_DAILY_TOKEN_LIMIT=20000
AI_USER_MONTHLY_TOKEN_LIMIT=50000
ENABLE_AI_DUPLICATE_DETECTION=true

# Admin Configuration
# Comma-separated list of user emails that should have admin access
# ADMIN_USERS=real-admin@yourdomain.com

# External Services (if needed)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Docker Profiles
# For local development with Redis: COMPOSE_PROFILES=local
# For production on Synology: COMPOSE_PROFILES=
COMPOSE_PROFILES=local